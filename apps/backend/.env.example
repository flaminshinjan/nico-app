PORT=4000
VITE_SERP_API_KEY=your_serpapi_key
VITE_GROQ_API_KEY=your_groq_api_key

# DOCX conversion settings
# hybrid: try Unoserver first, fallback to html-to-docx
# uno-only: require Unoserver for DOCX conversion
# legacy-only: always use html-to-docx fallback
DOCX_CONVERSION_MODE=hybrid
UNOSERVER_URL=http://127.0.0.1:2003
UNOCONVERT_BIN=unoconvert
DOCX_CONVERSION_TIMEOUT_MS=30000
DOCX_MAX_UPLOAD_MB=25
